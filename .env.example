# Copy to .env and fill in. Never commit .env — it is gitignored.

# Which config profile to load (app/config/loader.py).
# Default is the initial single-process setup: SQLite + in-memory, no external services.
APP_CONFIG=config/dev.yaml

# --- Model providers (default: Gemini free tier) ---
GEMINI_API_KEY=

# Optional alternative providers, selected via the config profile.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# --- Auth (P1.12) ---
JWT_SECRET=change-me

# --- Local object storage signed URLs (P1.11) ---
OBJECT_STORAGE_SIGNING_SECRET=change-me-too

# --- F6 market forecasting (forecast.enabled: true) ---
# `fixture` and `stooq` need no key. Keyed vendors (alphavantage/tiingo, when
# added) read theirs from the env var named by market_data.api_key_env.
# MARKET_DATA_API_KEY=
# TimesFM weights are fetched from HuggingFace on first use (pinned by
# forecast.revision) into HF_HOME. Air-gapped: pre-seed that cache, then
# HF_HUB_OFFLINE=1 so no download is ever attempted.
# HF_HOME=./data/hf
# HF_HUB_OFFLINE=1

# --- Scaling backends (config/scaled.yaml only) ---
# The DEFAULT profile needs NONE of these — it uses a SQLite file, in-memory
# cache/queue, and local disk. Uncomment only when a profile selects redis/postgres/s3.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/analyzer
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio12345
